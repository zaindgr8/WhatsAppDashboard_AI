# ── Twilio (Console → Account → API keys & tokens) ─────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Your WhatsApp sender. Sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+17702855755
# Optional: send through a Messaging Service instead of a single number
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of this dashboard (ngrok / Vercel / your domain). Used for
# webhook signature checks and delivery-status callbacks.
PUBLIC_BASE_URL=https://your-subdomain.ngrok.app

# ── AI agent (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Dashboard login (leave empty to disable login locally) ─────────────────
DASHBOARD_PASSWORD=change-me

# Optional
# AGENT_DEBOUNCE_MS=2500          # wait for the customer to finish typing
# TWILIO_SKIP_SIGNATURE=true      # only for local testing without a tunnel
# DISABLE_DEMO=true               # don't create sample chats when Twilio isn't set
# DATA_DIR=./storage

# ── n8n (optional) ─────────────────────────────────────────────────────────
# Set this to keep your n8n WhatsApp workflow as the agent. The dashboard
# receives each message, shows it, and forwards it to n8n.
# N8N_WEBHOOK_URL=https://your-n8n-host/webhook/your-whatsapp-workflow
# SYNC_INTERVAL_MS=15000          # how often to pull n8n's replies from Twilio
